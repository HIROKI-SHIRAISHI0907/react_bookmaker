// server/prisma-user/schema.prisma

generator client {
  provider = "prisma-client-js"
  output   = "../generated/user"
}

datasource db {
  provider = "postgresql"
  url      = env("USER_DATABASE_URL")
}

// 既存テーブルに合わせて PascalCase に
model users {
  userid       String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  name         String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  favorites favorites[]
}

model favorites {
  id        BigInt   @id @default(autoincrement())
  userId    String
  country   String   @db.VarChar(100)
  league    String   @db.VarChar(100)
  team      String   @db.VarChar(100)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user users @relation(fields: [userId], references: [userid], onDelete: Cascade)

  @@unique([userId, country, league], map: "uk_user_country_league")
  @@index([userId], map: "idx_fav_user")
  @@index([country, league, team], map: "idx_fav_country_league")
}

model stat_size_finalize_master {
  id            Int      @id @default(autoincrement())
  option_num    String   @default("0") @db.VarChar(1)
  options       String   @db.Text
  flg           String   @default("0") @db.VarChar(1)
  register_id   String   @db.VarChar(100)
  register_time DateTime @db.Timestamptz(0)
  update_id     String   @db.VarChar(100)
  update_time   DateTime @db.Timestamptz(0)
}
