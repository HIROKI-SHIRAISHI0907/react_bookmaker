generator client {
  provider = "prisma-client-js"
  output   = "../generated/master"
}

datasource db {
  provider = "postgresql"
  url      = env("MASTER_DATABASE_URL")
}

model team_member_master {
  id                     Int      @id @default(autoincrement())
  country                String?
  league                 String?
  team                   String
  score                  String?
  loan_belong            String?
  jersey                 String
  member                 String
  face_pic_path          String
  belong_list            String?
  height                 String?
  weight                 String?
  position               String?
  birth                  String?
  age                    String?
  market_value           String?
  injury                 String?
  versus_team_score_data String?
  retire_flg             String?  @db.Char(1)
  deadline               String?  @db.Char(1)
  deadline_contract_date String?
  latest_info_date       String?
  upd_stamp              String?
  del_flg                String   @default("0") @db.VarChar(1)
  register_id            String   @db.VarChar(100)
  register_time          DateTime @db.Timestamptz(0)
  update_id              String   @db.VarChar(100)
  update_time            DateTime @db.Timestamptz(0)

  @@unique([team, jersey, member, face_pic_path])
}

model country_league_master {
  id            Int      @id @default(autoincrement())
  country       String
  league        String
  team          String
  link          String
  del_flg       String   @default("0") @db.VarChar(1)
  register_id   String   @db.VarChar(100)
  register_time DateTime @db.Timestamptz(0)
  update_id     String   @db.VarChar(100)
  update_time   DateTime @db.Timestamptz(0)
}

model country_league_season_master {
  id                Int       @id @default(autoincrement())
  country           String
  league            String
  season_year       String
  start_season_date DateTime? @db.Timestamptz(0)
  end_season_date   DateTime? @db.Timestamptz(0)
  round             String?   @db.VarChar(2)
  path              String?
  icon              String?
  valid_flg         String    @default("0") @db.VarChar(1)
  del_flg           String    @default("0") @db.VarChar(1)
  register_id       String?   @db.VarChar(100)
  register_time     DateTime? @db.Timestamptz(0)
  update_id         String?   @db.VarChar(100)
  update_time       DateTime? @db.Timestamptz(0)
}

model team_color_master {
  id             Int       @id @default(autoincrement())
  country        String
  league         String
  team           String
  team_color_hex String?   @db.VarChar(7)
  register_id    String?   @db.VarChar(100)
  register_time  DateTime? @db.Timestamptz(0)
  update_id      String?   @db.VarChar(100)
  update_time    DateTime? @db.Timestamptz(0)
}

model future_master {
  seq                     BigInt    @id @default(autoincrement())
  game_team_category      String
  future_time             DateTime  @db.Timestamptz(0)
  home_rank               String?
  away_rank               String?
  home_team_name          String?
  away_team_name          String?
  home_max_getting_scorer String?
  away_max_getting_scorer String?
  home_team_home_score    String?
  home_team_home_lost     String?
  away_team_home_score    String?
  away_team_home_lost     String?
  home_team_away_score    String?
  home_team_away_lost     String?
  away_team_away_score    String?
  away_team_away_lost     String?
  game_link               String?
  data_time               DateTime? @db.Timestamptz(0)
  start_flg               String    @default("0") @db.VarChar(1)
  register_id             String?
  register_time           DateTime? @db.Timestamptz(0)
  update_id               String?
  update_time             DateTime? @db.Timestamptz(0)
}

model stat_size_finalize_master {
  id            Int      @id @default(autoincrement())
  option_num    String   @default("0") @db.VarChar(1)
  options       String   @db.Text
  flg           String   @default("0") @db.VarChar(1)
  register_id   String   @db.VarChar(100)
  register_time DateTime @db.Timestamptz(0)
  update_id     String   @db.VarChar(100)
  update_time   DateTime @db.Timestamptz(0)
}

model batch_job_exec {
  job_id        String    @id @db.Text
  batch_cd      String    @db.Text
  status        String    @db.Text
  register_id   String?   @db.VarChar(100)
  register_time DateTime? @db.Timestamptz(0)
  update_id     String?   @db.VarChar(100)
  update_time   DateTime? @db.Timestamptz(0)
}
