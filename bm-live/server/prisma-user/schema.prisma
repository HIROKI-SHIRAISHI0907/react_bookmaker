// server/prisma-user/schema.prisma

generator client {
  provider = "prisma-client-js"
  output   = "../generated/user"
}

datasource db {
  provider = "postgresql"
  url      = env("USER_DATABASE_URL")
}

model users {
  user_id       BigInt   @id @default(autoincrement())
  email         String   @unique
  passwordHash  String
  name          String?
  register_id   String   @db.VarChar(100)
  register_time DateTime @db.Timestamptz(0)
  update_id     String   @db.VarChar(100)
  update_time   DateTime @db.Timestamptz(0)

  favorites favorites[]
}

model favorites {
  id            BigInt   @id @default(autoincrement())
  user_id       BigInt

  // 1: country, 2: league, 3: team
  level         Int      @db.SmallInt

  country       String   @db.VarChar(100)

  // ★ NULLにせず "" を入れる（UNIQUEを効かせるため）
  league        String   @default("") @db.VarChar(100)
  team          String   @default("") @db.VarChar(100)

  register_id   String   @db.VarChar(100)
  register_time DateTime @db.Timestamptz(0)
  update_id     String   @db.VarChar(100)
  update_time   DateTime @db.Timestamptz(0)

  user users @relation(fields: [user_id], references: [user_id], onDelete: Cascade)

  // 3階層すべてを一意に
  @@unique([user_id, level, country, league, team], map: "uk_fav_scope")

  @@index([user_id], map: "idx_fav_user")
  @@index([user_id, country], map: "idx_fav_user_country")
  @@index([user_id, country, league], map: "idx_fav_user_country_league")
}
