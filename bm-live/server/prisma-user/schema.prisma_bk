// server/prisma-user/schema.prisma

generator client {
  provider = "prisma-client-js"
  output   = "../generated/user"
}

datasource db {
  provider = "postgresql"
  url      = env("USER_DATABASE_URL")
}

// 既存テーブルに合わせて PascalCase に
model users {
  userid       BigInt   @id @default(autoincrement())
  email        String   @unique
  passwordHash String
  name         String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  favorites favorites[]
}

model favorites {
  id        BigInt   @id @default(autoincrement())
  userId    BigInt
  country   String   @db.VarChar(100)
  league    String   @db.VarChar(100)
  team      String   @db.VarChar(100)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user users @relation(fields: [userId], references: [userid], onDelete: Cascade)

  @@unique([userId, country, league], map: "uk_user_country_league")
  @@index([userId], map: "idx_fav_user")
  @@index([country, league, team], map: "idx_fav_country_league")
}