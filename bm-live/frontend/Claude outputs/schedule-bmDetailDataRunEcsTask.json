{
  "Name": "bmDetailDataRunEcsTask",
  "Description": "B016 試合詳細スクレイピング（bm-detail-data-batch）を ecs-precheck-runner-detail-data 経由で起動。B012（0:10）が b016_game_detail_path.json を作った後",
  "ScheduleExpression": "cron(40 0 * * ? *)",
  "ScheduleExpressionTimezone": "Asia/Tokyo",
  "FlexibleTimeWindow": {
    "Mode": "OFF"
  },
  "State": "ENABLED",
  "Target": {
    "Arn": "arn:aws:lambda:ap-northeast-1:287190274071:function:ecs-precheck-runner-detail-data",
    "RoleArn": "arn:aws:iam::287190274071:role/bmSchedulerEcsRunTaskRole",
    "RetryPolicy": {
      "MaximumRetryAttempts": 2,
      "MaximumEventAgeInSeconds": 3600
    },
    "Input": "{\"BM_JOB\": \"B016\"}"
  }
}
